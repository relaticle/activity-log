ere (a service provider's ",[121,995,775],{},", middleware, runtime code).",[117,998,999,1000,131],{},"So the actual rule is ",[214,1001,1002],{},"last registration wins",[1004,1005,1008,1009,172,1012,1015,1016,131],"callout",{"color":1006,"icon":1007},"info","i-lucide-lightbulb","A clean split that avoids surprises: register ",[214,1010,1011],{},"stable defaults via config",[214,1013,1014],{},"panel-specific overrides via the plugin",", and ",[214,1017,1018],{},"runtime\u002Fconditional overrides via the facade",[133,1020,198,1022,202],{"id":1021},"replacing-the-built-in-activity_log-renderer",[121,1023,201],{},[117,1025,1026,1027,1029,1030,1032],{},"The service provider auto-registers ",[121,1028,190],{}," for the ",[121,1031,171],{}," type. To replace it wholesale — say, to redact sensitive fields, change the diff format, or embed approval buttons — register your own class for the same type key.",[223,1034,1036],{"className":225,"code":1035,"language":227,"meta":228,"style":228},"use Relaticle\\ActivityLog\\Filament\\ActivityLogPlugin;\n\nActivityLogPlugin::make()->renderers([\n    'activity_log' => \\App\\Timeline\\Renderers\\AuditedActivityLogRenderer::class,\n]);\n",[121,1037,1038,1058,1062,1076,1109],{"__ignoreMap":228},[232,1039,1040,1042,1044,1046,1048,1050,1052,1054,1056],{"class":234,"line":235},[232,1041,239],{"class":238},[232,1043,243],{"class":242},[232,1045,247],{"class":246},[232,1047,250],{"class":242},[232,1049,247],{"class":246},[232,1051,620],{"class":242},[232,1053,247],{"class":246},[232,1055,625],{"class":242},[232,1057,263],{"class":246},[232,1059,1060],{"class":234,"line":266},[232,1061,270],{"emptyLinePlaceholder":269},[232,1063,1064,1066,1068,1070,1072,1074],{"class":234,"line":273},[232,1065,625],{"class":276},[232,1067,279],{"class":246},[232,1069,655],{"class":282},[232,1071,658],{"class":246},[232,1073,661],{"class":282},[232,1075,664],{"class":246},[232,1077,1078,1080,1082,1084,1086,1088,1090,1092,1094,1096,1098,1100,1103,1105,1107],